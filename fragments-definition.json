{
  "family": "fragments",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::992382527628:role/LabRole",
  "taskRoleArn": "arn:aws:iam::992382527628:role/LabRole",
  "containerDefinitions": [
    {
      "name": "fragments",
      "image": "REPLACE_WITH_IMAGE",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "AWS_S3_BUCKET_NAME", "value": "hpahurkar-fragments" },
        { "name": "AWS_DYNAMODB_TABLE_NAME", "value": "fragments" },
        { "name": "AWS_COGNITO_POOL_ID", "value": "us-east-1_v3BeAm9MG" },
        { "name": "AWS_COGNITO_CLIENT_ID", "value": "5plpvg7j9b80e248laddildddb" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fragments",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
