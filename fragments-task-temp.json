{
    "family":  "fragments",
    "networkMode":  "awsvpc",
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "256",
    "memory":  "512",
    "executionRoleArn":  "arn:aws:iam::992382527628:role/LabRole",
    "taskRoleArn":  "arn:aws:iam::992382527628:role/LabRole",
    "containerDefinitions":  [
                                 {
                                     "name":  "fragments",
                                     "image":  "992382527628.dkr.ecr.us-east-1.amazonaws.com/fragments:latest",
                                     "essential":  true,
                                     "portMappings":  [
                                                          {
                                                              "containerPort":  8080,
                                                              "hostPort":  8080,
                                                              "protocol":  "tcp"
                                                          }
                                                      ],
                                     "environment":  [
                                                         {
                                                             "name":  "LOG_LEVEL",
                                                             "value":  "info"
                                                         },
                                                         {
                                                             "name":  "NODE_ENV",
                                                             "value":  "production"
                                                         },
                                                         {
                                                             "name":  "AWS_S3_BUCKET_NAME",
                                                             "value":  "fragments"
                                                         },
                                                         {
                                                             "name":  "AWS_DYNAMODB_TABLE_NAME",
                                                             "value":  "fragments"
                                                         }
                                                     ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/fragments",
                                                                              "awslogs-region":  "us-east-1",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          }
                                                          }
                                 }
                             ]
}
